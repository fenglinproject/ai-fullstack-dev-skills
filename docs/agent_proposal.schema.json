{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-fullstack/agent-proposal-v3.schema.json",
  "title": "Reviewed local change proposal V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "summary", "changes"],
  "properties": {
    "schema_version": {"const": 3},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "summary": {"type": "string", "minLength": 5, "maxLength": 500},
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "oneOf": [
          {"type":"object", "additionalProperties":false,
            "required":["path","action","expected_sha256","old_text","new_text"],
            "properties": {
              "path":{"type":"string","minLength":1,"maxLength":240},
              "action":{"const":"replace"},
              "expected_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
              "old_text":{"type":"string","minLength":1},
              "new_text":{"type":"string"}
            }
          },
          {"type":"object", "additionalProperties":false,
            "required":["path","action","content"],
            "properties": {
              "path":{"type":"string","minLength":1,"maxLength":240},
              "action":{"const":"create"},
              "content":{"type":"string"}
            }
          }
        ]
      }
    }
  }
}
